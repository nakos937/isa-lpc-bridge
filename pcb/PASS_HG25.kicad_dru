(version 1)
# JLCPCB multilayer 1 oz minimums, jlcpcb.com/capabilities/pcb-capabilities, fetched 2026-10-29. No safety margin.
(rule "min clearance" (constraint clearance (min 0.09mm)))
(rule "min track" (constraint track_width (min 0.09mm)))
(rule "min via" (constraint via_diameter (min 0.25mm)))
(rule "min drill" (constraint hole_size (min 0.15mm)))
(rule "via hole to hole" (constraint hole_to_hole (min 0.2mm)))
(rule "pad hole to hole" (condition "A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'") (constraint hole_to_hole (min 0.45mm)))
(rule "pad to pad" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint clearance (min 0.15mm)))
(rule "pad to track" (condition "A.Type == 'Pad' && B.Type == 'Track'") (constraint clearance (min 0.1mm)))
(rule "PTH to track" (condition "A.Pad_Type == 'Through-hole' && B.Type == 'Track'") (constraint hole_clearance (min 0.28mm)))
(rule "via hole to track" (condition "A.Type == 'Via' && B.Type == 'Track'") (constraint hole_clearance (min 0.2mm)))
(rule "edge" (constraint edge_clearance (min 0.2mm)))
