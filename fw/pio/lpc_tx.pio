; SPDX-License-Identifier: GPL-2.0-or-later
; LPC target response engine, script player (PIO1, GPIO base 16, loaded after lpc_fe).
;
; lpc_fe raises IRQ 0 after the last host nibble it sampled (clock N). Host cycle: ... TAR1 (clock N+1, host drives 1111),
; TAR2 (clock N+2, bus floats), SYNC from clock N+3. This engine skips the TAR2 edge and waits with LAD released. Core 1 claims
; a cycle by queueing W(Y, drive, RESUME): SYNC starts at N+3..N+5 (claim seen at the falling edge of N+2..N+4), within the
; 3 clock limit of LPC 1.1 4.2.1.9; then the
; wait-state SYNC (Y = 0110 or 0101) is driven every clock until core 0 queues the script. Unclaimed cycles are never driven:
; the next START (LFRAME# low) sends the engine back to idle.
;
; Script = one TX FIFO word per LCLK (a SAMPLE2 word takes two), played from the first rising edge after the FIFO became non-empty:
;   [3:0]  nibble put on LAD          [7:4] LAD direction (0xF drive, 0 release)       [11:8] next address (out pc; loaded at 0)
;   pullp: next word   start: END (back to idle)   wloop: RESUME (back to the wait-state loop, bus stays driven)
;        samp: SAMPLE2. The host drives data for this clock and the next: LAD is read in both
;           (at the falling edges), 8 bits are autopushed to the RX FIFO, byte = word >> 24, low nibble first.
;           The word's own nibble/direction should be 0/release.
; The CPU builds the whole response (SYNC, data, TAR, second byte of 16 bit DMA, ...), see src/lpc.c.
; If the host aborts (LFRAME# low) while we wait, the bus is released at once.
;
; STATUS = "TX FIFO level < 1". TX FIFO not joined (4 words, the RX FIFO is needed for SAMPLE2), ISR shifts right with autopush at 8 bits.
.pio_version 1
.program lpc_tx
.side_set 4 opt pindirs

public start:
    wait 1 irq 0
    wait 0 pin 5
    wait 1 pin 5        ; rising edge of TAR2; LAD stays released until the CPU claims the cycle
public wloop:
    wait 1 pin 5
    wait 0 pin 5        ; checked at the falling edge: host LFRAME# is settled, the queued word plays at the next rising edge
    jmp pin, chk        ; LFRAME# high: normal
    jmp start side 0    ; host START or abort: LAD released in the same cycle
public pullp:
    pull block          ; next word, taken before the edge so the pins change right after it
.wrap_target
play:
    wait 0 pin 5
    wait 1 pin 5
    out pins, 4
    out pindirs, 4
    out pc, 4           ; flag = next address: pullp, start (END), wloop (RESUME) or samp
public samp:
    wait 0 pin 5        ; SAMPLE2: host data sampled at the falling edges of this clock and the next
    in pins, 4
    pull block          ; next word is fetched early so the return costs no cycle
    wait 1 pin 5
    wait 0 pin 5
    in pins, 4          ; 8 bits autopush
.wrap
chk:
    mov x, status
    jmp !x, cpull       ; claim or script queued
    jmp wloop
cpull:                  ; the first word of a claim or script always drives: direction by side-set, same cycle as the nibble
    pull block          ; may land after the rising edge at high LCLK duty: then the word plays at once, still in time
    wait 1 pin 5
    out pins, 4 side 15
    out null, 4
    out pc, 4
